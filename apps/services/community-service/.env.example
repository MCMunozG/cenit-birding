# Referencia completa: docs/environment-reference.md. Este .env pertenece sólo a Community.
# Identidad y diagnóstico local; APP_DEBUG nunca debe permanecer activo fuera de desarrollo.
APP_NAME="Cenit Community"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004
# Base lógica propiedad de Community; referencias a otros contextos son ids opacos.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cenit_community
DB_USERNAME=cenit
DB_PASSWORD=cenit_dev
# Community sólo verifica JWT; prepare copia aquí la clave pública de Accounts.
JWT_ISSUER=cenit-accounts
JWT_PUBLIC_KEY_PATH=storage/app/keys/jwt-public.pem
