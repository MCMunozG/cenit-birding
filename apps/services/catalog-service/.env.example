# Referencia completa: docs/environment-reference.md. Este .env pertenece sólo a Catalog.
# Identidad y diagnóstico local; APP_DEBUG nunca debe permanecer activo fuera de desarrollo.
APP_NAME="Cenit Catalog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
# Base lógica propiedad de Catalog. No crear joins con las bases de otros contextos.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cenit_catalog
DB_USERNAME=cenit
DB_PASSWORD=cenit_dev
# Catalog sólo verifica JWT; prepare copia aquí la clave pública de Accounts.
JWT_ISSUER=cenit-accounts
JWT_PUBLIC_KEY_PATH=storage/app/keys/jwt-public.pem
